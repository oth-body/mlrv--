#N canvas 0 0 900 700 10;
#X obj 20 200 serialosc 8000 /monome;
#X obj 20 280 print device_register;
#X obj 200 280 print grid_key;
#X obj 380 280 print tilt;
#X obj 20 440 unpack f f f;
#X msg 20 480 3 3 15;
#X obj 200 480 pack f f 15;
#X obj 20 520 grid;
#X obj 20 560 print led_manual;
#X msg 20 640 bang;
#X obj 20 720 loadbang;
#X obj 20 760 print raw_key;
#X obj 380 520 print echo_led;
#X obj 380 440 pack s f f f;
#X obj 380 240 unpack s f f f;
#X text 20 20 m64_test - exercises every m64 feature via serialosc and grid primitives. launch via run_m64_test.sh;
#X text 20 320 SECTION 2 - on launch sets cell 3 over 3 to level 15 to confirm grid passthrough to LED works;
#X text 80 640 bang to serialosc inlet 0 forces a rescan;
#X text 20 360 SECTION 1 - input. key events arrive as x y state at serialosc outlet 1. tilt events arrive as sensor x y z at outlet 2. device_register prints every handshake;
#X text 20 580 SECTION 3 - press any key and the corresponding LED lights up at level 15. release also lights at 15 - this is a test echo not a state-tracking echo;
#X connect 10 0 5 0;
#X connect 5 0 7 0;
#X connect 5 0 8 0;
#X connect 4 0 6 0;
#X connect 4 1 6 1;
#X connect 6 0 12 0;
#X connect 6 0 7 0;
#X connect 0 0 1 0;
#X connect 0 1 2 0;
#X connect 0 1 4 0;
#X connect 0 1 11 0;
#X connect 0 2 3 0;
#X connect 0 2 14 0;
#X connect 14 2 13 1;
#X connect 14 1 13 2;
#X connect 14 0 13 3;
#X connect 7 0 0 1;
