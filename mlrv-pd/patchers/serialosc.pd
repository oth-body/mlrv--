#N canvas 0 0 600 550 10;
#X obj 20 20 inlet;
#X text 100 20 bang = send /serialosc/list and /serialosc/notify to 127.0.0.1:12002. output = the first /serialosc/device reply as a triple: serial name port.;
#X obj 250 20 loadbang;
#X msg 250 60 connect 127.0.0.1 12002;
#X obj 250 100 netsend -u -b;
#X obj 20 60 float \$1;
#X msg 20 100 list localhost \$1;
#X obj 20 140 oscformat /serialosc/list;
#X obj 150 140 oscformat /serialosc/notify;
#X obj 20 200 netreceive -u -b \$1;
#X obj 20 240 oscparse;
#X obj 20 280 route /serialosc/device;
#X obj 20 320 outlet;
#X text 150 280 TODO next turn: handle /serialosc/add and /serialosc/remove (rescan) and send /sys/port + /sys/prefix to the discovered device's own port to complete the handshake. not done yet.;
#X text 150 340 verified 2026-09-17 against a live Pd 0.56.5 install: oscformat needs a leading list selector for a symbol-leading message or it treats the first symbol as a method call. message-box dollar-signs read the runtime triggering message not the abstraction's creation args so the port number is routed in via a float object first. netreceive -u -b flag order confirmed against /usr/lib/pd/doc/5.reference/osc-format-parse-help.pd.;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 0 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 6 0 8 0;
#X connect 7 0 4 0;
#X connect 8 0 4 0;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
