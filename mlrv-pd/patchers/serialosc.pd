#N canvas 0 0 600 500 10;
#X obj 20 20 inlet;
#X text 100 20 bang = send /serialosc/list and /serialosc/notify to 127.0.0.1:12002. output = the first /serialosc/device reply as a triple: serial name port.;
#X obj 250 20 loadbang;
#X msg 250 60 connect 127.0.0.1 12002;
#X obj 250 100 netsend -u -b;
#X msg 20 70 localhost $1;
#X obj 20 110 oscformat /serialosc/list;
#X obj 150 110 oscformat /serialosc/notify;
#X obj 20 170 netreceive -u -b $1;
#X obj 20 210 oscparse;
#X obj 20 250 route /serialosc/device;
#X obj 20 290 outlet;
