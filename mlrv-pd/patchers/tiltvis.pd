#X obj 360 260 float 0;
#X obj 480 260 float 0;
#X obj 300 290 t f f f;
#X obj 360 290 t b;
#X obj 420 290 t f f;
#X obj 540 290 expr sqrt(\$f1*\$f1+\$f2*\$f2);
#X obj 620 290 expr \$f1*2.5;
