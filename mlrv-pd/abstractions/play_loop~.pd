#N canvas 0 0 500 550 10;
#X obj 10 20 inlet;
#X text 110 20 send a 3-float list: rate loopEndSamples loopStartSamples to update parameters atomically. send bang to retrigger from loop start.;
#X obj 10 60 route bang;
#X msg 10 100 0;
#X obj 150 100 unpack f f f;
#X obj 150 150 -;
#X obj 280 150 * $2;
#X obj 280 200 /;
#X obj 10 250 phasor~;
#X obj 10 300 *~;
#X obj 10 350 +~;
#X obj 10 400 tabread4~ $1;
#X obj 10 450 outlet~;
#X text 150 450 known limitation: tabread4~'s 4-point interpolation window can read up to about 2 samples outside loopStart..loopEnd at the loop seam. no crossfade yet. creation args: play_loop~ tableName sampleRate (both required no default).;
#X connect 0 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 8 1;
#X connect 2 1 4 0;
#X connect 4 2 5 1;
#X connect 4 2 10 1;
#X connect 4 1 5 0;
#X connect 5 0 7 1;
#X connect 5 0 9 1;
#X connect 4 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
