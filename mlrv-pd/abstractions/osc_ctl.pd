#N canvas 0 0 800 400 10;
#X obj 20 20 netreceive -u -b \$1;
#X obj 20 70 oscparse;
#X obj 20 120 route list;
#X obj 20 170 route mlrv;
#X obj 20 220 route ctl;
#X obj 20 270 unpack f f;
#X obj 20 300 pack f f;
#X msg 20 330 ctl 1 \$1 \$2;
#X obj 20 365 outlet;
#X text 300 20 OSC -> ctl adapter. listens on creation-arg port ( vanilla has no [udpreceive] -- probed \, so [netreceive -u -b] like serialosc.pd) for /mlrv/ctl <id 0-127> <val 0-1>. instantiate [osc_ctl 9000]. crab: oscparse splits the address on / and prefixes list (gotcha 3) \, hence the nested route chain.;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 1 6 1;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
