#N canvas 0 0 1200 700 10;
#X text 20 20 test_mlrv.pd -- automated end-to-end regression for mlrv.pd. Uses the SAME core wiring (mlrv_core.build_core) as the real mlrv.pd\, so this stays honest about what it is actually testing rather than a hand-copied approximation that could silently drift. Runs against tests/fake_serialosc.py (a fake daemon + fake grid device\, no real hardware needed) with its simulated key event pointed at the trigger row for slot 0. Captures master\'s real audio output via tabwrite~ and the LED command mapping.pd sends back\, so this verifies the whole chain (key press -> mapping -> file_poly -> master -> real signal\, AND file_poly -> mapping -> grid -> LED) without anyone needing to listen to anything. See run_mlrv_test.sh for the pass/fail assertions.;
#X obj 20 200 serialosc 8000 /monome;
#X obj 20 260 grid;
#X obj 300 200 file_poly;
#X obj 300 320 mapping;
#X obj 460 200 mixer;
#X obj 600 200 master;
#X obj 600 320 sig~ 0;
#X obj 600 360 send~ fxin;
#X obj 150 600 table mlrv-e2e-cap 4410;
#X obj 600 420 tabwrite~ mlrv-e2e-cap;
#X obj 20 320 print mlrv_e2e_led;
#X obj 20 400 loadbang;
#X msg 20 440 \; pd dsp 1;
#X msg 150 440 0.8;
#X msg 280 440 load 0 /tmp/mlrv_e2e_src.wav;
#X obj 410 440 delay 200;
#X msg 410 480 bang;
#X obj 20 520 delay 1000;
#X msg 20 560 bang;
#X obj 150 520 delay 2000;
#X msg 150 560 write /tmp/mlrv_e2e_cap.wav mlrv-e2e-cap;
#X obj 150 600 soundfiler;
#X obj 280 520 delay 2100;
#X msg 280 560 \; pd quit;
#X connect 1 1 4 0;
#X connect 3 1 4 1;
#X connect 4 0 3 0;
#X connect 4 1 2 0;
#X connect 2 0 1 1;
#X connect 3 2 5 0;
#X connect 3 3 5 1;
#X connect 3 4 5 2;
#X connect 3 5 5 3;
#X connect 5 0 6 0;
#X connect 7 0 8 0;
#X connect 6 0 10 0;
#X connect 2 0 11 0;
#X connect 12 0 13 0;
#X connect 12 0 14 0;
#X connect 14 0 6 1;
#X connect 12 0 15 0;
#X connect 15 0 3 0;
#X connect 12 0 16 0;
#X connect 16 0 17 0;
#X connect 17 0 1 0;
#X connect 12 0 18 0;
#X connect 18 0 19 0;
#X connect 19 0 10 0;
#X connect 12 0 20 0;
#X connect 20 0 21 0;
#X connect 21 0 22 0;
#X connect 12 0 23 0;
#X connect 23 0 24 0;
