#N canvas 0 0 700 500 10;
#X obj 20 20 loadbang;
#X msg 20 60 read /tmp/mlrv_pitch_test.wav pitchtest;
#X obj 20 100 soundfiler;
#X msg 250 20 \; pd dsp 1;
#X obj 20 140 delay 50;
#X obj 20 180 t b b;
#X obj 20 220 sample_voice~ pitchtest;
#X msg 100 180 1 0 2205 pitchtest;
#X obj 20 260 tabwrite~ capture_default;
#X obj 250 140 t b b b;
#X obj 250 220 sample_voice~ pitchtest;
#X msg 330 180 pitch 12;
#X msg 430 180 1 0 2205 pitchtest;
#X obj 250 260 tabwrite~ capture_pitched;
#X obj 500 20 delay 550;
#X obj 20 400 table pitchtest 2205;
#X obj 150 400 table capture_default 2205;
#X obj 300 400 table capture_pitched 2205;
#X msg 500 60 write /tmp/mlrv_pitch_default.wav capture_default;
#X obj 500 100 soundfiler;
#X msg 620 60 write /tmp/mlrv_pitch_pitched.wav capture_pitched;
#X obj 620 100 soundfiler;
