#N canvas 0 0 760 560 10;
#X text 20 20 tiltvis_demo.pd -- gyroscope visualizer: grid bubble-level + on-screen sliders. tap the grid to recenter. launch via mlrv-pd/run_tiltvis.sh (with GUI for the sliders) or with -nogui for headless.;
#X obj 20 200 serialosc 8000 /monome;
#X obj 20 260 grid;
#X obj 300 200 tiltvis;
#X obj 20 400 loadbang;
#X obj 20 320 print device;
#X obj 420 320 print center;
#X obj 300 260 route tilt center;
#X obj 300 300 unpack f f f;
#X obj 300 340 s tv_x;
#X obj 380 340 s tv_y;
#X obj 460 340 s tv_z;
#X obj 80 420 hsl 220 18 0 255 0 0 empty tv_x empty -2 -8 0 10 #dfdfdf #000000 #000000 0 1;
#X obj 320 400 vsl 18 160 0 255 0 0 empty tv_y empty -2 -8 0 10 #dfdfdf #000000 #000000 0 1;
#X obj 80 480 hsl 220 18 0 255 0 0 empty tv_z empty -2 -8 0 10 #dfdfdf #000000 #000000 0 1;
#X floatatom 80 380 5 0 0 0 - - - 0;
#X floatatom 360 380 5 0 0 0 - - - 0;
#X floatatom 80 440 5 0 0 0 - - - 0;
#X text 80 400 X (tilt);
#X text 360 540 Y (tilt);
#X text 80 460 energy (shake);
